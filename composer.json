{
    "name": "jumphp-games/moktar",
    "description": "MOKTAR",
    "type": "project",
    "license": "GPL-3.0-or-later",
    "require": {
        "php": ">=8.2",
        "jumphp/engine": "@dev"
    },
    "repositories": [
        {
            "type": "path",
            "url": "../../engine"
        },
        {
            "type": "vcs",
            "url": "https://github.com/davidnurdin/php-wasm-network"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform-check": false
    }
}
